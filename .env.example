# Rosmawati Thailor - Environment Template
# Salin ke .env dan sesuaikan nilainya pada server.

# Website
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Kontak butik
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_BOUTIQUE_ADDRESS=""
NEXT_PUBLIC_OPENING_HOURS=""

# Database PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:55432/rosmawati?schema=public"

# Admin - gunakan kredensial milik sendiri pada server
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="REPLACE_WITH_BCRYPT_HASH"
ADMIN_SESSION_TTL_HOURS="24"

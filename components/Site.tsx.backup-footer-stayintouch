          <span className="rt-editorial-motto">
            Elegance is in every stitch.
          </span>
        </div>

        {/* NAVIGASI */}
        <div className="rt-editorial-column">
          <h3>Explore</h3>

          <Link href="/" className="rt-editorial-link">

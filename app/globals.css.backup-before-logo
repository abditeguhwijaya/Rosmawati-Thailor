
/* ==========================================
   ROSMAWATI THAILOR - HEADER & FOOTER
   ========================================== */

.rt-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(251, 248, 244, 0.96);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid #eadfdb;
}

.rt-header-inner {
  width: min(100% - 64px, 1440px);
  min-height: 86px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}

.rt-brand {
  flex-shrink: 0;
  text-decoration: none;
}

.rt-brand-copy {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.rt-brand-copy b {
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 23px;
  font-weight: 600;
  color: #33292a;
  letter-spacing: -0.5px;
}

.rt-brand-copy small {
  font-size: 9px;
  letter-spacing: 3px;
  color: #977a7b;
}

.rt-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.rt-nav-link {
  position: relative;
  padding: 12px 16px;
  border-radius: 3px;
  color: #75696a;
  font-size: 13px;
  text-decoration: none;
  transition:
    color 220ms ease,
    background 220ms ease,
    transform 220ms ease;
}

.rt-nav-link:hover {
  color: #80565b;
  background: #f2e8e5;
}

.rt-nav-link.active {
  color: #fff;
  background: #80565b;
}

.rt-header-actions {
  display: flex;
  align-items: center;
  gap: 15px;
}

.rt-social-link {
  display: grid;
  place-items: center;
  color: #80565b;
  transition: color 200ms ease, transform 200ms ease;
}

.rt-social-link:hover {
  color: #b17c82;
  transform: translateY(-2px);
}

.rt-consult-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 13px 19px;
  color: #fff;
  background: #80565b;
  border: 1px solid #80565b;
  font-size: 12px;
  text-decoration: none;
  transition: background 220ms ease, transform 220ms ease;
}

.rt-consult-button:hover {
  background: #684349;
  transform: translateY(-2px);
}

.rt-menu-button {
  display: none;
}

.rt-footer {
  padding: 65px max(32px, calc((100% - 1320px) / 2)) 25px;
  background: #f1e9e4;
  border-top: 1px solid #e6d9d3;
}

.rt-footer-grid {
  display: grid;
  grid-template-columns: 1.6fr 0.8fr 1fr;
  gap: 70px;
  padding-bottom: 48px;
}

.rt-footer-brand p {
  max-width: 390px;
  margin: 22px 0 15px;
  color: #766a69;
  font-size: 14px;
  line-height: 1.9;
}

.rt-footer-motto {
  color: #80565b;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 20px;
  font-style: italic;
}

.rt-footer-column {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 15px;
}

.rt-footer-column > b {
  margin-bottom: 7px;
  color: #33292a;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 22px;
}

.rt-footer-column a,
.rt-footer-column span {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #766a69;
  font-size: 13px;
  text-decoration: none;
  transition: color 200ms ease;
}

.rt-footer-column a:hover {
  color: #80565b;
}

.rt-footer-bottom {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding-top: 22px;
  border-top: 1px solid #ddcec8;
  color: #897c79;
  font-size: 11px;
}

@media (max-width: 1050px) {
  .rt-header-inner {
    width: calc(100% - 40px);
    gap: 12px;
  }

  .rt-nav-link {
    padding: 10px;
    font-size: 12px;
  }

  .rt-header-actions {
    gap: 10px;
  }

  .rt-consult-button {
    padding: 12px;
    font-size: 11px;
  }
}

@media (max-width: 760px) {
  .rt-header-inner {
    min-height: 72px;
    width: calc(100% - 32px);
  }

  .rt-brand-copy b {
    font-size: 19px;
  }

  .rt-brand-copy small {
    font-size: 8px;
  }

  .rt-header-actions {
    margin-left: auto;
  }

  .rt-social-link {
    display: none;
  }

  .rt-consult-button {
    padding: 10px 12px;
    font-size: 10px;
  }

  .rt-menu-button {
    display: grid;
    place-items: center;
    padding: 8px;
    color: #80565b;
    background: transparent;
    border: 1px solid #eadfdb;
    cursor: pointer;
  }

  .rt-nav {
    position: absolute;
    top: calc(100% + 1px);
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 5px;
    padding: 0 20px;
    background: #fbf8f4;
    border-bottom: 1px solid #eadfdb;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 220ms ease,
      transform 220ms ease,
      visibility 220ms ease;
  }

  .rt-nav.show {
    padding-top: 16px;
    padding-bottom: 16px;
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  .rt-nav-link {
    width: 100%;
    padding: 13px 15px;
  }

  .rt-footer {
    padding: 45px 22px 22px;
  }

  .rt-footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 35px 20px;
  }

  .rt-footer-brand {
    grid-column: 1 / -1;
  }

  .rt-footer-bottom {
    flex-direction: column;
    gap: 9px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .rt-header *,
  .rt-footer * {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

/* ==========================================
   ROSMAWATI THAILOR - HOMEPAGE
   Luxury Editorial Boutique
   ========================================== */

.rt-home {
  overflow: hidden;
  background: #fbf8f4;
  color: #33292a;
}

.rt-home a {
  text-decoration: none;
}

.rt-home .rt-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  color: #997779;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 2.5px;
}

.rt-eyebrow-line {
  width: 28px;
  height: 1px;
  background: #b68b8d;
}

.rt-hero {
  width: min(100% - 100px, 1380px);
  min-height: 640px;
  margin: 0 auto;
  padding: 65px 0 75px;
  display: grid;
  grid-template-columns: 0.92fr 1.08fr;
  align-items: center;
  gap: 75px;
}

.rt-hero-content {
  max-width: 550px;
  animation: rtFadeUp 700ms ease both;
}

.rt-hero h1 {
  margin: 28px 0 22px;
  color: #392c2e;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: clamp(56px, 6.1vw, 88px);
  font-weight: 500;
  line-height: 0.99;
  letter-spacing: -2.5px;
}

.rt-hero h1 em,
.rt-section-heading h2 em,
.rt-about h2 em,
.rt-quote blockquote,
.rt-contact-content h2 em {
  color: #80565b;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-weight: 500;
}

.rt-hero-description {
  max-width: 440px;
  color: #786d6c;
  font-size: 14px;
  line-height: 2;
}

.rt-hero-actions,
.rt-contact-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 24px;
  margin-top: 30px;
}

.rt-button-primary,
.rt-button-outline {
  min-height: 49px;
  padding: 0 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 11px;
  background: #80565b;
  border: 1px solid #80565b;
  color: #fff;
  font-size: 12px;
  font-weight: 500;
  transition:
    background 250ms ease,
    border-color 250ms ease,
    transform 250ms ease,
    box-shadow 250ms ease;
}

.rt-button-primary:hover {
  background: #674248;
  border-color: #674248;
  transform: translateY(-3px);
  box-shadow: 0 9px 24px rgba(87, 53, 57, 0.15);
}

.rt-button-outline {
  color: #80565b;
  background: transparent;
}

.rt-button-outline:hover {
  color: #fff;
  background: #80565b;
  transform: translateY(-3px);
}

.rt-text-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #80565b;
  font-size: 12px;
  font-weight: 600;
  transition: gap 220ms ease, color 220ms ease;
}

.rt-text-link:hover {
  gap: 13px;
  color: #ae7d81;
}

.rt-hero-signature {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 48px;
  color: #9a8985;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 16px;
  font-style: italic;
}

.rt-hero-signature span {
  color: #a87c7f;
}

.rt-hero-visual {
  position: relative;
  min-width: 0;
  padding: 0 24px 32px 0;
  animation: rtFadeUp 850ms ease both;
}

.rt-hero-image {
  position: relative;
  width: 100%;
  height: 555px;
  overflow: hidden;
  background: #e9ded7;
}

.rt-hero-image img {
  object-fit: cover;
  object-position: center 35%;
  transition: transform 900ms ease;
}

.rt-hero-visual:hover .rt-hero-image img {
  transform: scale(1.035);
}

.rt-hero-stamp {
  position: absolute;
  top: 35px;
  right: -5px;
  width: 105px;
  height: 105px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  border: 1px solid rgba(255,255,255,.8);
  border-radius: 50%;
  background: rgba(251,248,244,.9);
  color: #80565b;
  font-size: 10px;
  line-height: 1.4;
  letter-spacing: 2px;
}

.rt-hero-stamp em {
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 19px;
}

.rt-hero-caption {
  position: absolute;
  right: 24px;
  bottom: 0;
  display: flex;
  justify-content: space-between;
  gap: 25px;
  width: calc(100% - 24px);
  padding-top: 13px;
  color: #927e7c;
  font-size: 9px;
  letter-spacing: 1.8px;
}

.rt-hero-side-note {
  position: absolute;
  top: 50%;
  right: -30px;
  color: #9a8582;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 12px;
  letter-spacing: 2px;
  writing-mode: vertical-rl;
  transform: translateY(-50%);
}

.rt-ticker {
  display: flex;
  align-items: center;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 18px;
  padding: 19px 30px;
  background: #80565b;
  color: #fff8f3;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 16px;
  letter-spacing: 0.5px;
}

.rt-section {
  width: min(100% - 100px, 1380px);
  margin: 0 auto;
  padding: 105px 0;
}

.rt-section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 42px;
}

.rt-section-heading h2,
.rt-about h2,
.rt-contact-content h2 {
  margin: 15px 0;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: clamp(39px, 4.3vw, 58px);
  font-weight: 500;
  line-height: 1.08;
}

.rt-section-heading p {
  max-width: 530px;
  margin: 0;
  color: #827574;
  font-size: 13px;
  line-height: 1.8;
}

.rt-home-products {
  gap: 25px;
}

.rt-home-products > * {
  min-width: 0;
}

.rt-about {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 90px;
  padding: 100px max(50px, calc((100% - 1280px) / 2));
  background: #f1e9e4;
}

.rt-about-visual {
  position: relative;
  min-height: 570px;
  background: #e5d9d1;
}

.rt-about-visual img {
  object-fit: cover;
}

.rt-about-image-note {
  position: absolute;
  left: 22px;
  bottom: 22px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 15px 19px;
  background: #fbf8f4;
  color: #80565b;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 17px;
}

.rt-about-content {
  max-width: 540px;
}

.rt-about-description {
  margin: 20px 0 30px;
  color: #786d6c;
  font-size: 14px;
  line-height: 2;
}

.rt-values {
  display: grid;
  gap: 23px;
  margin-bottom: 32px;
}

.rt-value-item {
  display: flex;
  align-items: flex-start;
  gap: 17px;
}

.rt-value-icon {
  width: 43px;
  height: 43px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border: 1px solid #d9c4bf;
  color: #80565b;
}

.rt-value-item b {
  display: block;
  margin-bottom: 5px;
  color: #453638;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 20px;
}

.rt-value-item p {
  margin: 0;
  color: #827574;
  font-size: 12px;
  line-height: 1.7;
}

.rt-quote {
  padding: 105px 25px;
  text-align: center;
  background: #fbf8f4;
}

.rt-quote-mark {
  height: 65px;
  margin-top: 20px;
  color: #c8a5a0;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 90px;
  line-height: 1;
}

.rt-quote blockquote {
  max-width: 790px;
  margin: 15px auto 22px;
  font-size: clamp(28px, 4vw, 43px);
  line-height: 1.35;
  font-style: italic;
}

.rt-quote-author {
  color: #897a77;
  font-size: 12px;
  letter-spacing: 1px;
}

.rt-craft,
.rt-process {
  padding: 95px max(50px, calc((100% - 1280px) / 2));
  background: #f4eeea;
}

.rt-craft-heading,
.rt-process-heading {
  margin-bottom: 45px;
}

.rt-craft-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.rt-craft-card {
  position: relative;
  min-height: 235px;
  padding: 32px;
  border: 1px solid #e3d5cf;
  background: #fbf8f4;
  transition: transform 280ms ease, box-shadow 280ms ease;
}

.rt-craft-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 35px rgba(82, 56, 55, 0.07);
}

.rt-craft-card > span {
  position: absolute;
  top: 25px;
  right: 28px;
  color: #bba09a;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 23px;
}

.rt-craft-card > svg {
  margin-bottom: 24px;
  color: #80565b;
}

.rt-craft-card h3,
.rt-process-step h3 {
  margin: 0 0 10px;
  color: #49383a;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 25px;
  font-weight: 500;
}

.rt-craft-card p,
.rt-process-step p {
  margin: 0;
  color: #827574;
  font-size: 12px;
  line-height: 1.9;
}

.rt-process {
  background: #fbf8f4;
}

.rt-process-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 25px;
}

.rt-process-step {
  min-width: 0;
}

.rt-process-number {
  position: relative;
  width: 47px;
  height: 47px;
  display: grid;
  place-items: center;
  margin-bottom: 25px;
  border: 1px solid #b88e90;
  border-radius: 50%;
  color: #80565b;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 18px;
}

.rt-process-line {
  position: absolute;
  top: 50%;
  left: calc(100% + 10px);
  width: calc(100% + 15px);
  height: 1px;
  background: #e0cfca;
}

.rt-process-note {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-top: 48px;
  padding: 18px 20px;
  background: #f3ece7;
  color: #786d6c;
  font-size: 12px;
  line-height: 1.7;
}

.rt-process-note svg {
  flex-shrink: 0;
  color: #80565b;
}

.rt-contact-cta {
  position: relative;
  overflow: hidden;
  padding: 90px 25px;
  text-align: center;
  background: #eee2dc;
}

.rt-contact-decoration {
  position: absolute;
  top: -100px;
  right: 4%;
  color: rgba(128, 86, 91, 0.055);
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 450px;
  line-height: 1;
  pointer-events: none;
}

.rt-contact-content {
  position: relative;
  z-index: 1;
  max-width: 700px;
  margin: auto;
}

.rt-contact-content h2 {
  margin-top: 18px;
}

.rt-contact-content > p {
  max-width: 550px;
  margin: 0 auto;
  color: #786d6c;
  font-size: 14px;
  line-height: 1.9;
}

.rt-contact-actions {
  justify-content: center;
  gap: 13px;
}

@keyframes rtFadeUp {
  from {
    opacity: 0;
    transform: translateY(18px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* TABLET */
@media (max-width: 1000px) {
  .rt-hero {
    width: calc(100% - 64px);
    gap: 35px;
  }

  .rt-hero-image {
    height: 470px;
  }

  .rt-about {
    gap: 45px;
    padding-left: 32px;
    padding-right: 32px;
  }

  .rt-about-visual {
    min-height: 480px;
  }

  .rt-process-grid {
    grid-template-columns: repeat(3, 1fr);
    row-gap: 40px;
  }

  .rt-process-line {
    display: none;
  }
}

/* MOBILE */
@media (max-width: 760px) {
  .rt-hero {
    width: calc(100% - 40px);
    padding: 55px 0 45px;
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .rt-hero h1 {
    font-size: clamp(53px, 13vw, 72px);
    letter-spacing: -1.8px;
  }

  .rt-hero-description {
    font-size: 13px;
  }

  .rt-hero-signature {
    margin-top: 28px;
  }

  .rt-hero-visual {
    padding-right: 12px;
  }

  .rt-hero-image {
    height: min(115vw, 490px);
  }

  .rt-hero-stamp {
    width: 82px;
    height: 82px;
    right: -2px;
    font-size: 8px;
  }

  .rt-hero-stamp em {
    font-size: 16px;
  }

  .rt-hero-side-note {
    right: -17px;
    font-size: 9px;
  }

  .rt-hero-caption {
    font-size: 8px;
  }

  .rt-ticker {
    justify-content: flex-start;
    gap: 13px 25px;
    padding: 17px 20px;
    font-size: 14px;
  }

  .rt-section {
    width: calc(100% - 40px);
    padding: 70px 0;
  }

  .rt-section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 17px;
    margin-bottom: 28px;
  }

  .rt-section-heading h2,
  .rt-about h2,
  .rt-contact-content h2 {
    font-size: 43px;
  }

  .rt-about {
    grid-template-columns: 1fr;
    gap: 35px;
    padding: 65px 20px;
  }

  .rt-about-visual {
    min-height: 390px;
  }

  .rt-about-description {
    font-size: 13px;
  }

  .rt-quote {
    padding: 75px 25px;
  }

  .rt-quote blockquote {
    font-size: 30px;
  }

  .rt-craft,
  .rt-process {
    padding: 70px 20px;
  }

  .rt-craft-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .rt-craft-card {
    min-height: 190px;
    padding: 25px;
  }

  .rt-process-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .rt-process-step {
    display: grid;
    grid-template-columns: 48px 1fr;
    column-gap: 17px;
  }

  .rt-process-number {
    grid-row: span 2;
    margin: 0;
  }

  .rt-process-step h3 {
    margin: 0 0 5px;
    font-size: 23px;
  }

  .rt-process-step p {
    grid-column: 2;
  }

  .rt-process-note {
    margin-top: 35px;
    padding: 15px;
  }

  .rt-contact-cta {
    padding: 70px 20px;
  }

  .rt-contact-decoration {
    top: -15px;
    right: -35px;
    font-size: 260px;
  }

  .rt-contact-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .rt-contact-actions > a {
    width: 100%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .rt-home *,
  .rt-home *::before,
  .rt-home *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* ==========================================
   ROSMAWATI THAILOR - PRODUCT CARD
   ========================================== */

.rt-product-card {
  min-width: 0;
  overflow: hidden;
  background: transparent;
  transition: transform 280ms ease;
}

.rt-product-card:hover {
  transform: translateY(-5px);
}

.rt-product-photo {
  position: relative;
  display: block;
  width: 100%;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: #eee5df;
}

.rt-product-image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  transition: transform 650ms cubic-bezier(.2,.7,.2,1);
}

.rt-product-card:hover .rt-product-image {
  transform: scale(1.055);
}

.rt-product-overlay {
  position: absolute;
  right: 14px;
  bottom: 14px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 15px;
  background: rgba(251,248,244,.95);
  color: #80565b;
  font-size: 11px;
  opacity: 0;
  transform: translateY(8px);
  transition: opacity 250ms ease, transform 250ms ease;
}

.rt-product-card:hover .rt-product-overlay,
.rt-product-photo:focus-visible .rt-product-overlay {
  opacity: 1;
  transform: translateY(0);
}

.rt-product-info {
  padding: 17px 2px 10px;
}

.rt-product-category {
  display: block;
  margin-bottom: 9px;
  color: #a17f7e;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1.7px;
  text-transform: uppercase;
}

.rt-product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
}

.rt-product-bottom h3 {
  margin: 0;
  color: #392c2e;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 23px;
  font-weight: 500;
  line-height: 1.2;
}

.rt-product-bottom h3 a {
  color: inherit;
  text-decoration: none;
  transition: color 200ms ease;
}

.rt-product-bottom h3 a:hover {
  color: #80565b;
}

.rt-product-price {
  flex-shrink: 0;
  padding-top: 4px;
  color: #80565b;
  font-size: 12px;
  font-weight: 600;
}

.rt-product-detail-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-top: 13px;
  color: #917779;
  font-size: 11px;
  transition: gap 200ms ease, color 200ms ease;
}

.rt-product-detail-link:hover {
  gap: 12px;
  color: #80565b;
}

@media (max-width: 760px) {
  .rt-product-info {
    padding-top: 12px;
  }

  .rt-product-bottom {
    flex-direction: column;
    gap: 6px;
  }

  .rt-product-bottom h3 {
    font-size: 20px;
  }

  .rt-product-price {
    font-size: 12px;
  }

  .rt-product-overlay {
    right: 8px;
    bottom: 8px;
    padding: 9px 11px;
    font-size: 10px;
    opacity: 1;
    transform: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .rt-product-card,
  .rt-product-image,
  .rt-product-overlay,
  .rt-product-detail-link {

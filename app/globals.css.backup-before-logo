  border-radius: 50px;
  font-family: "DM Sans", sans-serif;
  font-size: 9px;
  font-weight: 500;
  letter-spacing: .2px;
  text-decoration: none;
  box-sizing: border-box;
  transition: all .25s ease;
}

.rt-home .rt-collection .rt-product-detail-link:hover {
  color: #fff;
  background: #80565b;
  border-color: #80565b;
}

/* Tablet */
@media (max-width: 1050px) {
  .rt-home .rt-collection {
    width: calc(100% - 50px) !important;
  }

  .rt-home .rt-collection .rt-home-products {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
}

/* Mobile */
@media (max-width: 600px) {
  .rt-home .rt-collection {
    width: calc(100% - 30px) !important;
    padding: 55px 0 65px;
  }

  .rt-home .rt-collection .rt-section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 12px;
  }

  .rt-home .rt-collection .rt-section-heading h2 {
    font-size: 39px;
  }

  .rt-home .rt-collection .rt-home-products {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .rt-home .rt-collection .rt-product-card {
    padding: 5px;
    border-radius: 13px;
  }

  .rt-home .rt-collection .rt-product-photo {
    border-radius: 9px;
  }

  .rt-home .rt-collection .rt-product-info {
    padding: 10px 4px 5px;
  }

  .rt-home .rt-collection .rt-product-bottom {
    align-items: flex-start;
    flex-direction: column;
    gap: 4px;
  }

  .rt-home .rt-collection .rt-product-bottom h3 {
    font-size: 19px;
  }

  .rt-home .rt-collection .rt-product-price {
    font-size: 9px;
  }

  .rt-home .rt-collection .rt-product-detail-link {
    min-height: 32px;
    margin-top: 10px;
    padding: 7px 9px;
    font-size: 8px;
  }
}

/* ==========================================
   FINAL MOBILE LAYOUT FIX
   ROSMAWATI THAILOR
   ========================================== */

@media (max-width: 760px) {
  /* Cegah padding dan border menambah lebar elemen */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
  }

  .rt-home,
  main,
  .rt-catalog-page {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: clip;
  }

  /* HEADER: logo kiri, menu kanan */
  .rt-header-inner {
    width: 100%;
    min-height: 68px;
    padding: 0 16px;
    gap: 10px;
  }

  .rt-brand {
    min-width: 0;
    flex: 1 1 auto;
  }

  .rt-brand-copy b {
    font-size: 17px;
    white-space: nowrap;
  }

  .rt-brand-copy small {
    font-size: 7px;
    letter-spacing: 2px;
  }

  .rt-header-actions {
    display: none;
  }

  .rt-menu-button {
    display: grid;
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    padding: 8px;
    place-items: center;
  }

  .rt-nav {
    left: 0;
    right: 0;
    width: 100%;
    max-width: 100%;
  }

  /* HERO DAN SECTION */
  .rt-hero,
  .rt-section {
    width: calc(100% - 36px);
    max-width: 100%;
    min-width: 0;
  }

  .rt-hero-content,
  .rt-section-heading,
  .rt-section-heading > div {
    width: 100%;
    min-width: 0;
  }

  .rt-hero h1,
  .rt-section-heading h2,
  .rt-about h2,
  .rt-contact-content h2 {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .rt-hero-signature {
    display: flex;
    flex-wrap: wrap;
    max-width: 100%;
    white-space: normal;
    line-height: 1.5;
  }

  /* ABOUT: teks dan daftar nilai tidak boleh terpotong */
  .rt-home .rt-about {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding: 65px 24px;
    overflow: hidden;
  }

  .rt-about-content,
  .rt-about-content > *,
  .rt-values,
  .rt-value-item,
  .rt-value-item > div {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .rt-about-description,
  .rt-value-item p {
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .rt-value-item {
    gap: 14px;
  }

  .rt-value-item > div {
    flex: 1 1 0;
  }

  /* CONTACT: tombol tersusun vertikal dan tidak keluar layar */
  .rt-contact-cta {
    width: 100%;
    max-width: 100%;
    padding: 65px 20px;
    overflow: hidden;
  }

  .rt-contact-content {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .rt-contact-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    gap: 12px;
  }

  .rt-contact-actions > a,
  .rt-contact-actions .rt-button-primary,
  .rt-contact-actions .rt-button-outline {
    display: flex;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: 58px;
    padding: 12px 16px;
    justify-content: center;
    text-align: center;
    white-space: normal;
    border-radius: 999px;
  }

  /* KATALOG: kategori bisa digeser horizontal */
  .rt-category-filter,
  .rt-category-tabs,
  .rt-catalog-filters {
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .rt-home-products {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .rt-home-products > *,
  .rt-product-card {
    min-width: 0;
    max-width: 100%;
  }

  .rt-product-card h3,
  .rt-product-price {
    overflow-wrap: anywhere;
  }

  /* FOOTER */
  .rt-footer {
    width: 100%;
    max-width: 100%;
    padding: 40px 22px 22px;
  }

  .rt-footer-grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 28px 16px;
  }

  .rt-footer-brand {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .rt-footer-column {
    min-width: 0;
  }

  .rt-footer-bottom {
    flex-direction: column;
    gap: 8px;
    overflow-wrap: anywhere;
  }

  .rt-footer a,
  .rt-footer a:visited {
    color: #766a69;
  }

  .rt-footer-brand a,
  .rt-footer-brand a:visited {
    color: #33292a;
  }

  .rt-footer-brand .monogram {
    color: #80565b;
  }
}

/* HP kecil */
@media (max-width: 390px) {
  .rt-header-inner {
    padding: 0 12px;
  }

  .rt-brand-copy b {
    font-size: 15px;
  }

  .rt-home-products {
    gap: 10px;
  }

  .rt-home .rt-about {
    padding-right: 19px;
    padding-left: 19px;
  }

  .rt-contact-cta {
    padding-right: 16px;
    padding-left: 16px;
  }
}

/* FIX HEADER MOBILE - ROSMAWATI THAILOR */

@media (max-width: 760px) {
  .rt-header {
    width: 100%;
    max-width: 100%;
    overflow: visible;
  }

  .rt-header-inner {
    display: flex;
    width: 100% !important;
    min-height: 68px;
    padding: 0 16px !important;
    gap: 12px;
    justify-content: space-between;
    box-sizing: border-box;
  }

  /* Logo */
  .rt-brand {
    flex: 1 1 auto;
    min-width: 0;
  }

  .rt-brand-copy b {
    font-size: 17px;
    white-space: nowrap;
  }

  /* Sembunyikan tombol konsultasi di header HP */
  .rt-header-actions {
    display: none !important;
  }

  /* Posisikan kotak hamburger di ujung kanan */
  .rt-menu-button,
  .menubtn {
    position: static !important;
    display: grid !important;
    flex: 0 0 42px;
    width: 42px;
    height: 42px;
    margin: 0 !important;
    padding: 8px;
    transform: none !important;
    box-sizing: border-box;
  }

  /* Dropdown menu mengikuti lebar header */
  .rt-nav {
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box;
  }
}

/* =====================================================
   ROSMAWATI THAILOR - LUXURY DESKTOP REDESIGN
   DESKTOP ONLY - MOBILE DAN TABLET TIDAK DIUBAH
   ===================================================== */

@media screen and (min-width: 1101px) {

  :root {
    --rt-wine: #4b1025;
    --rt-wine-dark: #310817;
    --rt-gold: #c49a58;
    --rt-gold-light: #ead3a2;
    --rt-ivory: #fbf7f1;
    --rt-text: #38272b;
    --rt-muted: #827477;
  }

  /* HEADER */
  .rt-header {
    position: sticky;
    top: 0;
    padding: 12px 0;
    background: rgba(251,247,241,.94);
    border-bottom: 0;
    backdrop-filter: blur(18px);
  }

  .rt-header-inner {
    width: min(calc(100% - 64px),1540px);
    min-height: 82px;
    padding: 0 30px;
    gap: 28px;
    border: 1px solid rgba(196,154,88,.65);
    border-radius: 20px;
    background: linear-gradient(110deg,#310817,#55152c 55%,#3b0c1c);
    box-shadow: 0 12px 35px rgba(49,8,23,.13);
  }

  .rt-header .rt-brand {
    gap: 16px;
  }

  .rt-header .monogram {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border: 1px solid rgba(234,211,162,.8);
    border-radius: 14px;
    color: var(--rt-gold-light);
    font-family: "Cormorant Garamond",Georgia,serif;
    font-size: 43px;
    font-weight: 600;
    background: rgba(255,255,255,.04);
  }

  .rt-header .rt-brand-copy b {
    color: #fff8ed;
    font-size: 28px;
  }

  .rt-header .rt-brand-copy small {
    color: var(--rt-gold-light);
    font-size: 9px;
    letter-spacing: 3px;
  }

  /* NAVIGASI */
  .rt-header .rt-nav {
    gap: 8px;
  }

  .rt-header .rt-nav-link {
    padding: 13px 17px;
    border-radius: 999px;
    color: #f3e8e4;
    font-size: 13px;
    transition: all .25s ease;
  }

  .rt-header .rt-nav-link:hover {
    color: var(--rt-gold-light);
    background: rgba(255,255,255,.08);
  }

  .rt-header .rt-nav-link.active {
    color: var(--rt-wine-dark);
    background: linear-gradient(135deg,#f2dfb8,#d6ad6d);
  }

  .rt-header .rt-social-link {
    color: var(--rt-gold-light);
  }

  .rt-header .rt-social-link:hover {
    color: #fff;
  }

  .rt-header .rt-consult-button {
    min-height: 47px;
    padding: 0 22px;
    border: 1px solid var(--rt-gold-light);
    border-radius: 999px;
    color: var(--rt-wine-dark);
    background: linear-gradient(135deg,#f2dfb8,#d6ad6d);
    font-size: 12px;
    font-weight: 700;
  }

  .rt-header .rt-consult-button:hover {
    color: var(--rt-wine-dark);
    background: #fff0d1;
  }

  /* HOMEPAGE */
  .rt-home {
    background: var(--rt-ivory);
    color: var(--rt-text);
  }

  /* HERO */
  .rt-hero {
    width: min(calc(100% - 120px),1460px);
    min-height: 690px;
    padding: 65px 0 75px;
    grid-template-columns: .9fr 1.1fr;
    gap: 65px;
  }

  .rt-home .rt-eyebrow {
    color: #9c713d;
    letter-spacing: 3px;
  }

  .rt-eyebrow-line {
    width: 35px;
    background: var(--rt-gold);
  }

  .rt-hero h1 {
    margin: 25px 0;
    color: var(--rt-wine);
    font-size: clamp(68px,6.2vw,94px);
    line-height: .98;
    letter-spacing: -3px;
  }

  .rt-hero h1 em,
  .rt-section-heading h2 em,
  .rt-about h2 em,
  .rt-contact-content h2 em {
    color: #b18a4f;
  }

  .rt-hero-description {
    max-width: 490px;
    color: #75666a;
    font-size: 15px;
    line-height: 2;
  }

  /* TOMBOL */
  .rt-button-primary {
    min-height: 54px;
    padding: 0 28px;
    border: 1px solid var(--rt-wine);
    border-radius: 999px;
    background: linear-gradient(120deg,#4b1025,#6a1b37);
    box-shadow: 0 8px 22px rgba(75,16,37,.16);
  }

  .rt-button-primary:hover {
    background: var(--rt-wine-dark);
    border-color: var(--rt-gold);
  }

  .rt-text-link {
    color: var(--rt-wine);
    font-size: 13px;
  }

  .rt-text-link:hover {
    color: #b18a4f;
  }

  .rt-hero-signature {
    color: #927c75;
    font-size: 18px;
  }

  .rt-hero-signature span {
    color: var(--rt-gold);
  }

  /* FOTO HERO */
  .rt-hero-visual {
    padding: 0 25px 35px 0;
  }

  .rt-hero-image {
    height: 590px;
    border-radius: 220px 220px 12px 12px;
    background: #eadbd0;
    box-shadow: 0 22px 55px rgba(72,36,39,.13);
  }

  .rt-hero-stamp {
    top: 30px;
    right: -8px;
    width: 112px;
    height: 112px;
    border: 1px solid var(--rt-gold);
    background: rgba(251,247,241,.96);
    color: var(--rt-wine);
    box-shadow: 0 8px 25px rgba(49,8,23,.08);
  }

  .rt-hero-stamp em {
    color: #a47a42;
  }

  .rt-hero-caption {
    color: #927c75;
  }

  .rt-hero-side-note {
    color: #a17d54;
  }

  /* TICKER */
  .rt-ticker {
    padding: 23px 40px;
    background: linear-gradient(100deg,#310817,#57152d,#310817);
    color: #f6e6c9;
    font-size: 17px;
    letter-spacing: .8px;
  }

  /* SECTION */
  .rt-section {
    width: min(calc(100% - 120px),1400px);
    padding: 115px 0;
  }

  .rt-section-heading {
    margin-bottom: 48px;
  }

  .rt-section-heading h2,
  .rt-about h2,
  .rt-contact-content h2 {
    color: var(--rt-wine);
  }

  .rt-section-heading p {
    color: var(--rt-muted);
    font-size: 14px;
  }

  .rt-home-products {
    gap: 30px;
  }

  /* TENTANG KAMI */
  .rt-about {
    padding: 110px max(60px,calc((100% - 1320px)/2));
    background: linear-gradient(135deg,#f1e5dc,#fbf7f1);
  }

  .rt-about-description {
    color: #75666a;
    line-height: 2.1;
  }

  .rt-value-item b {
    color: var(--rt-wine);
  }

  /* CRAFT */
  .rt-craft {
    padding: 110px max(60px,calc((100% - 1320px)/2));
    background: #f5eee7;
  }

  .rt-craft-card {
    padding: 38px;
    border: 1px solid #e6d5c3;
    border-radius: 16px;
    background: #fffaf4;
    box-shadow: 0 8px 25px rgba(66,35,39,.035);
  }

  .rt-craft-card:hover {
    border-color: var(--rt-gold);
    box-shadow: 0 18px 38px rgba(66,35,39,.09);
  }

  .rt-craft-card > svg {
    color: #a77d45;
  }

  .rt-craft-card h3,
  .rt-process-step h3 {
    color: var(--rt-wine);
  }

  /* PROSES PEMESANAN */
  .rt-process {
    padding: 110px max(60px,calc((100% - 1320px)/2));
    background: var(--rt-ivory);
  }

  .rt-process-number {
    border-color: var(--rt-gold);
    color: var(--rt-wine);
    background: #fffaf4;
  }

  .rt-process-note {
    border: 1px solid #e6d5c3;
    border-radius: 12px;
    background: #f5eee7;
  }

  .rt-process-note svg {
    color: #a77d45;
  }

  /* KONTAK */
  .rt-contact-cta {
    padding: 110px 30px;
    background: linear-gradient(120deg,#f0e1d6,#f9f2e9);
  }

  .rt-contact-decoration {
    color: rgba(75,16,37,.055);
  }

  .rt-contact-content h2 {
    color: var(--rt-wine);
  }

  .rt-contact-content > p {
    color: #75666a;
  }

  /* FOOTER */
  .rt-footer {
    padding-top: 80px;
    background: #310817;
    border-top: 2px solid var(--rt-gold);
  }

  .rt-footer-brand .rt-brand-copy b,
  .rt-footer-column > b {
    color: #fff4e8;
  }

  .rt-footer-brand .rt-brand-copy small,
  .rt-footer-motto {
    color: var(--rt-gold-light);
  }

  .rt-footer-brand p,
  .rt-footer-column a,
  .rt-footer-column span {
    color: #d4c1bb;
  }

  .rt-footer-column a:hover {
    color: var(--rt-gold-light);
  }

  .rt-footer-bottom {
    border-color: rgba(234,211,162,.25);
    color: #c5ada8;
  }
}

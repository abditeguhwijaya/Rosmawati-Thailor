{
  "name": "rosmawati-thailor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/dev-db.mjs",
    "db:stop": "node scripts/db-stop.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "admin:hash": "node scripts/hash-admin-password.mjs",
    "verify:fase1": "tsx scripts/verify-fase1.ts",
    "test:e2e": "node scripts/e2e-admin.mjs",
    "test:e2e:auth": "node scripts/e2e-auth.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.468.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "embedded-postgres": "^17.11.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "playwright-core": "^1.64.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "wrangler": "^4.163.0"
  }
}